FOUNDRY_BASE_URL=https://YOUR-RESOURCE-NAME.openai.azure.com
FOUNDRY_API_KEY=
FOUNDRY_MODEL=YOUR-DEPLOYMENT-NAME

# Optional stable routing key for requests sharing a prompt prefix.
FOUNDRY_PROMPT_CACHE_KEY=

# Agent only: foundry (default) or openrouter. Evaluation CLIs still use Foundry.
MODEL_PROVIDER=foundry
# Opt-in: set to openrouter to send conversation + tool data there on transient failures.
MODEL_FALLBACK_PROVIDER=
OPENROUTER_API_KEY=
# Explicit tool-capable model ID, e.g. vendor/model; no automatic model selection.
OPENROUTER_MODEL=
